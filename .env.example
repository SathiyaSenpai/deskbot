# JEEVA Robot Environment Configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# Groq API (cloud LLM fallback)
GROQ_API_KEY=your_groq_api_key_here

# Bhashini API (Government of India TTS/ASR)
BHASHINI_API_KEY=your_bhashini_key_here
BHASHINI_USER_ID=your_bhashini_user_id

# WiFi Configuration (for development only — production uses NVS)
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password

# Server Configuration
SERVER_PORT=3000
JWT_SECRET=generate_a_random_32_char_string

# OTA Update Server
OTA_SERVER_URL=https://your-server.com/ota
